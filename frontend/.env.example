# Frontend env — copy to frontend/.env.local (gitignored).
# Vite only exposes VITE_* variables to the browser bundle.
#
# Leave both unset to run the app 100% local (IndexedDB, no login screen).
# Set both to enable Supabase auth + routing gated behind login.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
